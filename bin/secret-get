#!/usr/bin/env bash
#
# secret-get <item>
#
# Print the `credential` field of 1Password item op://agent-keys/<item> on
# stdout (no trailing newline), for one caller to capture:
#
#   value="$(secret-get xai)" || exit 1
#
# The 1Password service account token is read from the macOS Keychain
# (generic password, service `op-sa-agent-keys`, account $USER) and handed to
# that single `op read` invocation through its environment only: it is never
# exported to this script's other children, never put on a command line and
# never printed. On any failure this prints one short line on stderr that
# names neither the value nor the token, prints nothing on stdout and exits
# non-zero. See README "Agent keys".

set -Eeuo pipefail

readonly keychain_service="op-sa-agent-keys"
readonly vault="agent-keys"

fail() {
  echo "secret-get: $1" >&2
  exit "${2:-1}"
}

[ "$#" -eq 1 ] || fail "usage: secret-get <item>" 2
item="$1"

# Item names become part of an op:// reference; accept only plain names so a
# caller cannot point it at another vault, item or field.
case "$item" in
  '' | -* | *[!A-Za-z0-9._-]*) fail "invalid item name" 2 ;;
esac

# MCP hosts and GUI apps often start this with a minimal PATH. Append (never
# prepend) the usual install locations so a caller's PATH still wins.
PATH="${PATH:-/usr/bin:/bin}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

command -v security >/dev/null 2>&1 || fail "macOS 'security' command not found"
command -v op >/dev/null 2>&1 || fail "1Password CLI 'op' not found"

account="${USER:-$(id -un)}"

token="$(security find-generic-password -s "$keychain_service" -a "$account" -w 2>/dev/null)" ||
  fail "cannot read Keychain item '$keychain_service'"
[ -n "$token" ] || fail "Keychain item '$keychain_service' is empty"

# The subshell confines the exported token to `op` alone. Connect settings
# would make `op` ignore the service account, so drop them for this call.
# op's own stderr is discarded rather than relayed, so nothing it might echo
# can reach the caller's terminal or logs.
value="$(
  unset OP_CONNECT_HOST OP_CONNECT_TOKEN
  export OP_SERVICE_ACCOUNT_TOKEN="$token"
  exec op read --no-newline "op://$vault/$item/credential" 2>/dev/null
)" || fail "cannot read item '$item' from vault '$vault'"
unset token

[ -n "$value" ] || fail "item '$item' has an empty credential"

printf '%s' "$value"
