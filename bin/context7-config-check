#!/usr/bin/env python3
"""Check that no agent config holds a static Context7 credential.

The Context7 key reaches Claude Code only through the `headersHelper`
(bin/context7-headers) and Copilot CLI only through the bin/context7-mcp
launcher (README "Agent keys"). Neither file is managed by this repo, so a
static key can creep back in by hand or by an old `claude mcp add`. This
check reads, under $HOME:

  * ~/.claude.json: user-scope `mcpServers` and every
    `projects.<path>.mcpServers`
  * leftover copies Claude Code may leave next to it:
    ~/.claude.json.tmp.*, ~/.claude.json.backup*,
    ~/.claude/backups/.claude.json.backup*
  * ~/.copilot/mcp-config.json: `mcpServers`

A Context7 entry is any server whose name, url, command or args mention
"context7". It fails when such an entry carries a `headers` or `env` field
with entries (a literal or `${VAR}` value instead of the helper or the
launcher) or an `--api-key` argument, and when any string anywhere in a
file contains the Context7 key prefix `ctx7sk-`.

Output names files and entry paths only, never a value. Exit status:
0 clean (a missing file is fine), 1 a static credential was found,
2 a file could not be read or has an unexpected shape (never a pass).
"""

import glob
import json
import os
import sys

KEY_PREFIX = "ctx7sk-"
FINDING, UNKNOWN = 1, 2


def display(path, home):
    if path == home or path.startswith(home + os.sep):
        return "~" + path[len(home):]
    return path


def is_context7(name, entry):
    probes = [name, entry.get("url"), entry.get("command")]
    args = entry.get("args")
    if isinstance(args, list):
        probes.extend(args)
    return any(isinstance(p, str) and "context7" in p.lower() for p in probes)


def safe_name(name):
    # A key name holding the key prefix would put the key into our output.
    return "<redacted>" if KEY_PREFIX in name else name


def key_prefix_paths(node, path):
    """Yield the path of every string value that contains the key prefix."""
    if isinstance(node, dict):
        for k, v in node.items():
            yield from key_prefix_paths(v, f"{path}.{safe_name(str(k))}" if path else safe_name(str(k)))
    elif isinstance(node, list):
        for i, v in enumerate(node):
            yield from key_prefix_paths(v, f"{path}[{i}]")
    elif isinstance(node, str) and KEY_PREFIX in node:
        yield path or "<root>"


def check_servers(servers, where, report):
    """Check one `mcpServers` object; return False on an unexpected shape."""
    if servers is None:
        return True
    if not isinstance(servers, dict):
        report(UNKNOWN, f"{where}: not an object")
        return False
    ok = True
    for name, entry in servers.items():
        label = f"{where}.{safe_name(name)}"
        if not isinstance(entry, dict):
            report(UNKNOWN, f"{label}: not an object")
            ok = False
            continue
        if not is_context7(name, entry):
            continue
        for field in ("headers", "env"):
            value = entry.get(field)
            if value in (None, {}):
                continue
            if isinstance(value, dict):
                report(FINDING, f"{label}: static {field} instead of the helper or launcher")
            else:
                report(UNKNOWN, f"{label}: {field} is not an object")
                ok = False
        args = entry.get("args")
        if isinstance(args, list) and any(
            isinstance(a, str) and a.split("=", 1)[0] == "--api-key" for a in args
        ):
            report(FINDING, f"{label}: key flag on the command line")
    return ok


def check_claude(doc, report):
    if not isinstance(doc, dict):
        report(UNKNOWN, "top level is not an object")
        return
    check_servers(doc.get("mcpServers"), "mcpServers", report)
    projects = doc.get("projects")
    if projects is None:
        return
    if not isinstance(projects, dict):
        report(UNKNOWN, "projects: not an object")
        return
    for proj, conf in projects.items():
        where = f"projects[{safe_name(proj)}]"
        if not isinstance(conf, dict):
            report(UNKNOWN, f"{where}: not an object")
            continue
        check_servers(conf.get("mcpServers"), f"{where}.mcpServers", report)


def check_copilot(doc, report):
    if not isinstance(doc, dict):
        report(UNKNOWN, "top level is not an object")
        return
    check_servers(doc.get("mcpServers"), "mcpServers", report)


def check_file(path, kind, home):
    """Return (levels, lines) for one file; lines never hold a value."""
    shown = display(path, home)
    lines, levels = [], set()

    def report(level, msg):
        levels.add(level)
        tag = "static credential" if level == FINDING else "cannot verify"
        lines.append(f"{tag}: {shown}: {msg}")

    try:
        with open(path, "rb") as fh:
            raw = fh.read()
    except OSError:
        report(UNKNOWN, "cannot be read")
        return levels, lines
    try:
        doc = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        # Fixed message: the decoder's own error can quote the input.
        report(UNKNOWN, "not valid JSON")
        return levels, lines
    (check_claude if kind == "claude" else check_copilot)(doc, report)
    for p in key_prefix_paths(doc, ""):
        report(FINDING, f"{p}: holds a Context7 key")
    return levels, lines


def targets(home):
    claude = [os.path.join(home, ".claude.json")]
    claude += sorted(glob.glob(os.path.join(glob.escape(home), ".claude.json.tmp.*")))
    claude += sorted(glob.glob(os.path.join(glob.escape(home), ".claude.json.backup*")))
    claude += sorted(
        glob.glob(os.path.join(glob.escape(home), ".claude", "backups", ".claude.json.backup*"))
    )
    out = [(p, "claude") for p in claude]
    out.append((os.path.join(home, ".copilot", "mcp-config.json"), "copilot"))
    return out


def main():
    home = os.environ.get("HOME", "")
    if not home or not os.path.isabs(home):
        print("context7-config-check: HOME is not an absolute path", file=sys.stderr)
        return UNKNOWN
    home = home.rstrip(os.sep) or os.sep
    seen = set()
    for path, kind in targets(home):
        if not os.path.lexists(path):
            print(f"absent: {display(path, home)}")
            continue
        levels, lines = check_file(path, kind, home)
        seen |= levels
        for line in lines:
            print(line, file=sys.stderr)
        if not levels:
            print(f"ok: {display(path, home)}")
    if FINDING in seen:
        print(
            "context7-config-check: static Context7 credential found; use the headersHelper "
            "(Claude Code) or bin/context7-mcp (Copilot CLI), see README \"Agent Keys\", "
            "then rotate the key",
            file=sys.stderr,
        )
    if UNKNOWN in seen:
        print("context7-config-check: could not verify every file (see above)", file=sys.stderr)
        return UNKNOWN
    return FINDING if FINDING in seen else 0


if __name__ == "__main__":
    sys.exit(main())
