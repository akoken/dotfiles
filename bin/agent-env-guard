#!/usr/bin/env python3
"""PreToolUse command guard for Claude Code and Codex.

Denies shell commands that dump a whole environment or list processes with
their environments:

  * ps with an environment flag: -E in a dash cluster (macOS), or e in a
    BSD-style cluster without a dash (ps eww, ps auxe, ps axe)
  * bare env / printenv, env with only options or assignments and no command
  * export -p, bare export, bare set, declare/typeset/readonly with no name
    (declare -x, declare -p, typeset -x, readonly -p)
  * any read of /proc/<pid>/environ

It allows ordinary ps (ps aux, ps -ef, ps -o pid,command -p 123),
printenv NAME, export NAME=value, set -euo pipefail, declare -p NAME, and
env NAME=value command ... / env -u NAME command ... (the wrapped command is
still checked).

LIMITATION: this guard inspects only the command line the agent typed. It
cannot see what a test, script, build tool or interpreter (node, python,
ruby, ...) does once it runs, so a program that reads process environments
internally is NOT stopped by it, and indirection such as `p=ps; $p -E` or
building the command inside a script gets past it. Shell syntax is read by
the lexing contract below for sh, bash and zsh; executable forms it does not
model are denied visibly, and the other limits are listed at its end. Pair
it with keeping secrets out of exported shell variables.

Input: the hook JSON on stdin ({"tool_name": "Bash", "tool_input":
{"command": "..."}}). Output: a PreToolUse deny decision on stdout (exit 0)
or nothing (allow). Deny messages name the matched form and the safe
alternative; they never echo the command text, so a value typed on the
command line cannot leak through the hook output.
"""

import json
import os
import re
import shlex
import sys

SAFE_HINT = (
    "Read a single variable with `printenv NAME` (or `[ -n \"${NAME+x}\" ]` to "
    "test presence), list processes without environments (`ps -o pid,ppid,command`), "
    "and pass values with `env NAME=value command`."
)

SHELLS = {"sh", "bash", "zsh", "dash", "ksh", "fish"}
# Options that take a separate argument, per wrapper.
SUDO_ARG_OPTS = {"-u", "-g", "-C", "-D", "-h", "-p", "-R", "-T", "-U", "-r", "-t"}
NICE_ARG_OPTS = {"-n"}
XARGS_ARG_OPTS = {"-E", "-I", "-J", "-L", "-n", "-P", "-R", "-S", "-s", "-d", "-a"}
TIMEOUT_ARG_OPTS = {"-s", "-k", "--signal", "--kill-after"}
ENV_ARG_OPTS = {"-u", "-S", "-P", "-C", "--unset", "--chdir", "--split-string"}
# ps options (macOS and procps) that consume the following token, in dash
# clusters (`-o pid`) and in BSD-style clusters without a dash (`axo pid`).
PS_ARG_LETTERS = set("GgMNOoptUuDkq")
PS_BSD_ARG_LETTERS = set("OoptUk")

ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?\+?=")
UNKNOWN = "\x00"  # stands for text whose value the guard cannot know
MAX_COMMAND_CHARS = 200_000
MAX_DEPTH = 8

# ---------------------------------------------------------------------------
# Lexing support contract
#
# Supported dialects (verified profiles, measured by the shell corpus in
# tests/): POSIX sh (dash 0.5; bash 3.2 in sh mode), bash 3.2 and 5.x, and
# zsh 5.9, each started without user startup files. A command
# is denied when ANY of them would run a denied form. Where they read the
# typed text differently, the guard either takes the reading that runs more
# (the union) or denies visibly. It denies visibly when the lexer meets
# text it cannot resolve (L9).
#
# All access to the typed command text goes through LogicalSource; nothing
# else reads the raw string (tests/test_agent_env_guard.py checks this
# structurally).
#
# L1 Quoting. '...' is literal. $'...' (ANSI-C; bash, zsh, newer dash) is
#    literal and ends at an unescaped quote; a \' inside it is denied,
#    because a shell without $'...' support ends the string there. "..." is
#    literal except for $(...), $((...)), ${...}, $name and backticks. A
#    backslash outside single quotes makes the next character literal.
# L2 Line continuation. Backslash-newline is removed before anything else is
#    read in code, double quotes, backticks, ${...}, arithmetic, here-document
#    delimiter words, unquoted here-document bodies and here-string words. It
#    is kept in '...', $'...', comments and quoted here-document bodies. zsh
#    does not join an operator split by a continuation (parse error, nothing
#    runs); sh and bash do, so the joined reading is the union.
# L3 Comments. # at the start of a word in code comments out the rest of the
#    physical line (no continuation).
# L4 Operators are recognised by longest match on the logical text:
#    ; ;; ;& ;;& & && | || |& ( ) < > >> << <<- <<< <& >& &> &>> <> >|
# L5 Here-string <<<: its word is ordinary code.
# L6 Here-document <<word / <<-word. The delimiter is the word after L2 and
#    quote removal; any quoting or backslash in it makes the body literal. A
#    delimiter containing an expansion is denied. Bodies start after the next
#    newline in code, in order. <<- strips leading tabs per physical line.
#    Quoted body: physical lines, compared literally, not inspected.
#    Unquoted body: a line ending in an unescaped backslash continues before
#    the delimiter comparison in bash and zsh but not in dash, so a delimiter
#    reached through a continuation (either way) is denied; $(...), ${...},
#    $((...)) and backticks in the body are inspected; quotes are literal
#    characters. A body without its delimiter runs to the end of the command.
# L7 Substitutions. $(...) is lexed in place, recursively, and ends at its
#    own top-level ")". Backtick text is unescaped (\` \\ \$) and inspected
#    as a new command. ${...} is scanned for substitutions inside, with '
#    taken as a literal character there (so more is inspected, never less).
# L8 Arithmetic. In $((...)) and in ((...)) at the start of a word, << is a
#    shift. dash reads ((...)) as nested subshells, so its content is also
#    inspected as code. Multi-line arithmetic, or a $(( that does not close
#    with )), is denied.
# L9 Refusals (visible deny): unterminated quote, substitution, ${...} or
#    backtick; here-document without a delimiter or with an expanding one;
#    $'...' containing \'; case inside $(...) (bash 3.2 and zsh disagree);
#    the zsh code-running forms - glob qualifiers with e or + such as
#    *(e:'cmd':), ${(e)...} expansion flags and =(...) process substitution;
#    input over MAX_COMMAND_CHARS; nesting deeper than MAX_DEPTH; sh -c,
#    eval, watch and env -S with text the guard cannot know.
# L10 Grammar. Reserved words that start or continue compound commands
#    ({ } ! if then elif else while until do time coproc nocorrect noglob,
#    repeat N) are skipped to reach the command they run; standalone { and }
#    end a command; for, select, case, function, [[ heads are not commands.
#    A word with an unknown part (a substitution or $name) is never taken as
#    a variable name or a command; as a command name it is not resolved.
#
# Not modelled: aliases, functions defined elsewhere, variable indirection
# (p=ps; $p -E), what a started program does, zsh options set by startup
# files, and any syntax not listed above.
# ---------------------------------------------------------------------------


# dash compares each physical body line with the delimiter; bash and zsh
# compare the line after joining continuations. Where the two readings end
# the body at different lines, the guard cannot know which shell runs it.
DELIMITER_SPLIT = "a here-document delimiter reached through a line continuation is read differently by dash and bash/zsh"


class Deny(Exception):
    """A denied form; the message is safe to show (no command text)."""


class LogicalSource:
    """The only reader of the typed command text.

    peek/take see the logical text: with cont=True every backslash-newline
    pair is skipped first (L2). cont=False reads raw characters, for the
    contexts where continuation does not apply and for the character after
    an escaping backslash.
    """

    def __init__(self, text):
        if len(text) > MAX_COMMAND_CHARS:
            raise Deny("the command is too large to inspect")
        self._text = text
        self._pos = 0

    def _skip(self, pos, cont):
        while cont and self._text.startswith("\\\n", pos):
            pos += 2
        return pos

    def peek(self, k=0, cont=True):
        pos = self._pos
        for step in range(k + 1):
            pos = self._skip(pos, cont)
            if pos >= len(self._text):
                return None
            if step == k:
                return self._text[pos]
            pos += 1
        return None

    def at(self, literal, cont=True):
        return all(self.peek(k, cont) == ch for k, ch in enumerate(literal))

    def take(self, n=1, cont=True):
        out = []
        for _ in range(n):
            self._pos = self._skip(self._pos, cont)
            if self._pos >= len(self._text):
                break
            out.append(self._text[self._pos])
            self._pos += 1
        return "".join(out)

    def take_physical_line(self):
        """Raw text up to the next newline (consumed, not returned)."""
        end = self._text.find("\n", self._pos)
        if end < 0:
            line, self._pos = self._text[self._pos:], len(self._text)
        else:
            line, self._pos = self._text[self._pos:end], end + 1
        return line

    def physical_eof(self):
        return self._pos >= len(self._text)


OPERATORS = sorted(
    [";", ";;", ";&", ";;&", "&", "&&", "|", "||", "|&", "(", ")", "<", ">", ">>",
     "<<", "<<-", "<<<", "<&", ">&", "&>", "&>>", "<>", ">|"],
    key=len, reverse=True,
)
REDIRECT_OPS = {"<", ">", ">>", "<<", "<<-", "<<<", "<&", ">&", "&>", "&>>", "<>", ">|"}
BLANKS = " \t"
NAME_START = set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_")
SPECIAL_PARAMS = set("@*#?-$!0123456789")


class Word:
    def __init__(self):
        self.parts = []  # (kind, text): kind in lit, esc, sq, dq, unknown
        self.quoted = False

    def add(self, kind, text=""):
        self.parts.append((kind, text))
        if kind in ("esc", "sq", "dq"):
            self.quoted = True

    def value(self):
        """Quote-removed value; unknown parts become UNKNOWN."""
        return "".join(UNKNOWN if kind == "unknown" else text for kind, text in self.parts)

    def literal_start(self):
        return self.parts[0][1] if self.parts and self.parts[0][0] == "lit" else ""

    def __bool__(self):
        return bool(self.parts)


class Lexer:
    """Mode-stack lexer over one LogicalSource (contract L1-L9).

    Produces tokens ("word", Word) / ("op", str) / ("nl", None) and collects
    nested command texts and token lists that must also be checked.
    """

    def __init__(self, src, depth):
        if depth > MAX_DEPTH:
            raise Deny("command nesting is too deep to inspect")
        self.src = src
        self.depth = depth
        self.nested_tokens = []  # token lists of $(...)
        self.nested_texts = []   # backtick, ((...)) and here-doc substitution texts

    # -- code ---------------------------------------------------------------
    def lex_code(self, closing=None, in_subst=False):
        src, tokens, word, pending, parens = self.src, [], Word(), [], 0

        def flush():
            nonlocal word
            if word:
                tokens.append(("word", word))
                word = Word()

        while True:
            c = src.peek()
            if c is None:
                flush()
                if closing:
                    raise Deny("an unterminated command substitution cannot be inspected")
                if pending:
                    pass  # here-document marker without a body line: nothing runs from it
                return tokens
            if c in BLANKS:
                flush()
                src.take()
                continue
            if c == "\n":
                flush()
                src.take()
                tokens.append(("nl", None))
                for delimiter, strip_tabs, quoted in pending:
                    self.read_heredoc_body(delimiter, strip_tabs, quoted)
                pending = []
                continue
            if c == "#" and not word:
                src.take_physical_line()
                tokens.append(("nl", None))
                for delimiter, strip_tabs, quoted in pending:
                    self.read_heredoc_body(delimiter, strip_tabs, quoted)
                pending = []
                continue
            if c == "(" and word:
                self.glued_paren(word)
                continue
            if c == "(" and src.at("((") and not word:
                self.double_paren()
                tokens.append(("word", self.unknown_word()))
                continue
            if closing and c == ")" and parens == 0:
                flush()
                src.take()
                return tokens
            op = next((o for o in OPERATORS if src.at(o)), None)
            if op:
                flush()
                src.take(len(op))
                tokens.append(("op", op))
                parens += {"(": 1, ")": -1}.get(op, 0)
                if op in ("<<", "<<-"):
                    pending.append(self.heredoc_delimiter(op == "<<-"))
                continue
            at_command = not tokens or tokens[-1][0] == "nl" or (tokens[-1][0] == "op" and tokens[-1][1] not in REDIRECT_OPS)
            if in_subst and not word and at_command and src.at("case") and src.peek(4) in (None, " ", "\t", "\n", ";"):
                raise Deny("`case` inside a command substitution is read differently by bash and zsh")
            self.word_char(word, mode="code")

    def unknown_word(self):
        w = Word()
        w.add("unknown")
        return w

    def word_char(self, word, mode):
        src = self.src
        c = src.peek()
        if c == "\\":
            src.take()
            nxt = src.take(cont=False)
            word.add("esc", nxt)
        elif c == "'" and mode != "param":
            src.take()
            word.add("sq", self.read_single_quoted())
        elif c == '"':
            src.take()
            self.read_double_quoted(word)
        elif c == "`":
            src.take()
            self.read_backtick()
            word.add("unknown")
        elif c == "$":
            self.dollar(word)
        else:
            word.add("lit", src.take())

    def read_single_quoted(self):
        out = []
        while True:
            c = self.src.take(cont=False)
            if c == "":
                raise Deny("an unterminated quote cannot be inspected")
            if c == "'":
                return "".join(out)
            out.append(c)

    def read_ansi_c(self):
        out = []
        while True:
            c = self.src.take(cont=False)
            if c == "":
                raise Deny("an unterminated quote cannot be inspected")
            if c == "\\":
                nxt = self.src.take(cont=False)
                if nxt == "'":
                    raise Deny("an escaped quote inside $'...' ends the string in some shells but not others")
                out.append("\\" + nxt)
                continue
            if c == "'":
                return "".join(out)
            out.append(c)

    def read_double_quoted(self, word):
        src = self.src
        while True:
            c = src.peek()
            if c is None:
                raise Deny("an unterminated quote cannot be inspected")
            if c == '"':
                src.take()
                word.quoted = True
                return
            if c == "\\":
                src.take()
                word.add("dq", src.take(cont=False))
            elif c == "`":
                src.take()
                self.read_backtick()
                word.add("unknown")
            elif c == "$":
                self.dollar(word)
            else:
                word.add("dq", src.take())

    def dollar(self, word):
        src = self.src
        if src.at("$'"):
            src.take(2)
            word.add("sq", self.read_ansi_c())
        elif src.at('$"'):
            src.take()
        elif src.at("$(("):
            src.take(3)
            self.read_arithmetic(closing="))")
            word.add("unknown")
        elif src.at("$("):
            src.take(2)
            self.nested_tokens.append(Lexer(src, self.depth + 1).lex_nested(self))
            word.add("unknown")
        elif src.at("${"):
            src.take(2)
            self.read_param()
            word.add("unknown")
        elif src.peek(1) is not None and (src.peek(1) in NAME_START or src.peek(1) in SPECIAL_PARAMS):
            src.take()
            if src.peek() in SPECIAL_PARAMS:
                src.take()
            else:
                while src.peek() is not None and (src.peek().isalnum() or src.peek() == "_"):
                    src.take()
            word.add("unknown")
        else:
            word.add("lit", src.take())

    def lex_nested(self, parent):
        tokens = self.lex_code(closing=")", in_subst=True)
        parent.nested_tokens.extend(self.nested_tokens)
        parent.nested_texts.extend(self.nested_texts)
        return tokens

    def read_backtick(self):
        src, out = self.src, []
        while True:
            c = src.take()
            if c == "":
                raise Deny("an unterminated backtick substitution cannot be inspected")
            if c == "`":
                self.nested_texts.append("".join(out))
                return
            if c == "\\":
                nxt = src.take(cont=False)
                out.append(nxt if nxt in "`\\$" else "\\" + nxt)
                continue
            out.append(c)

    def read_param(self):
        """Body of ${...} (L7); zsh (e) flags are refused (L9)."""
        src = self.src
        if src.peek() == "(":
            flags = []
            src.take()
            while src.peek() not in (None, ")"):
                flags.append(src.take())
            if "e" in "".join(flags):
                raise Deny("the zsh ${(e)...} flag runs command text")
        depth = 1
        scratch = Word()
        while True:
            c = src.peek()
            if c is None:
                raise Deny("an unterminated ${...} cannot be inspected")
            if c == "}":
                depth -= 1
                src.take()
                if depth == 0:
                    return
                continue
            if src.at("${"):
                src.take(2)
                self.read_param()
                continue
            if c == "{":
                depth += 1
            self.word_char(scratch, mode="param")

    def read_arithmetic(self, closing):
        """Arithmetic text up to `))`; substitutions inside are inspected."""
        src, depth, out = self.src, 0, []
        while True:
            c = src.peek()
            if c is None:
                raise Deny("unterminated arithmetic cannot be inspected")
            if c == "\n":
                raise Deny("a multi-line arithmetic expression cannot be inspected")
            if c == ")" and depth == 0:
                if src.at("))"):
                    src.take(2)
                    return "".join(out)
                raise Deny("an arithmetic expansion that is not closed by `))` cannot be inspected")
            if c == "(":
                depth += 1
            elif c == ")":
                depth -= 1
            if c in "$`\\\"'":
                scratch = Word()
                self.word_char(scratch, mode="param")
                out.append(" ")
                continue
            out.append(src.take())

    def double_paren(self):
        """((...)) at the start of a word (L8): arithmetic for bash/zsh,
        nested subshells for dash, so the text is also inspected as code."""
        self.src.take(2)
        text = self.read_arithmetic(closing="))")
        self.nested_texts.append(text)

    def glued_paren(self, word):
        """`(` right after word text: zsh glob qualifier, extglob, `=(...)`
        or a function definition `name()`."""
        src = self.src
        if word.literal_start().startswith("="):
            raise Deny("the zsh =(...) process substitution runs a command")
        src.take()
        depth, inner = 1, []
        while True:
            c = src.peek()
            if c is None:
                raise Deny("an unterminated `(` cannot be inspected")
            if c == "(":
                depth += 1
            elif c == ")":
                depth -= 1
                if depth == 0:
                    src.take()
                    break
            if c in "$`":
                self.word_char(Word(), mode="param")
                inner.append(" ")
                continue
            inner.append(src.take())
        qualifiers = "".join(inner)
        if word.value().endswith("="):
            word.add("lit", "(" + qualifiers + ")")  # array assignment; substitutions were inspected
            return
        if not qualifiers.strip():
            word.add("lit", "()")  # function definition; the body is checked as code
            return
        if "+" in qualifiers or any(
            ch == "e" and k + 1 < len(qualifiers) and not qualifiers[k + 1].isalnum()
            for k, ch in enumerate(qualifiers)
        ):
            raise Deny("a zsh glob qualifier with e or + runs command text")
        word.add("lit", "(" + qualifiers + ")")

    # -- here-documents -----------------------------------------------------
    def heredoc_delimiter(self, strip_tabs):
        src = self.src
        while src.peek() is not None and src.peek() in BLANKS:
            src.take()
        word = Word()
        while src.peek() is not None and src.peek() not in BLANKS + "\n;&|<>()":
            before = len(self.nested_tokens) + len(self.nested_texts)
            self.word_char(word, mode="code")
            if any(kind == "unknown" for kind, _ in word.parts):
                raise Deny("a here-document delimiter with an expansion cannot be inspected")
            if len(self.nested_tokens) + len(self.nested_texts) != before:
                raise Deny("a here-document delimiter with an expansion cannot be inspected")
        if not word:
            raise Deny("a here-document without a delimiter cannot be inspected")
        return word.value(), strip_tabs, word.quoted

    def read_heredoc_body(self, delimiter, strip_tabs, quoted):
        src, body = self.src, []
        while not src.physical_eof():
            line = src.take_physical_line()
            if strip_tabs:
                line = line.lstrip("\t")
            if not quoted:
                spanned = False
                while self.continues(line) and not src.physical_eof():
                    more = src.take_physical_line()
                    more = more.lstrip("\t") if strip_tabs else more
                    if more == delimiter:
                        raise Deny(DELIMITER_SPLIT)
                    line, spanned = line[:-1] + more, True
                if spanned and line == delimiter:
                    raise Deny(DELIMITER_SPLIT)
            if line == delimiter:
                break
            body.append(line)
        if not quoted:
            self.inspect_heredoc_body("\n".join(body))

    @staticmethod
    def continues(line):
        stripped = line.rstrip("\\")
        return (len(line) - len(stripped)) % 2 == 1

    def inspect_heredoc_body(self, body):
        sub = Lexer(LogicalSource(body), self.depth + 1)
        src = sub.src
        while src.peek(cont=False) is not None:
            c = src.peek(cont=False)
            if c == "\\":
                src.take(2, cont=False)
            elif c in "$`":
                sub.word_char(Word(), mode="param")
            else:
                src.take(cont=False)
        self.nested_tokens.extend(sub.nested_tokens)
        self.nested_texts.extend(sub.nested_texts)

SEPARATOR_OPS = {";", ";;", ";&", ";;&", "&", "&&", "|", "||", "|&", "(", ")"}
RESERVED_PREFIXES = {"{", "!", "if", "then", "elif", "else", "while", "until", "do",
                     "coproc", "nocorrect", "noglob", "-"}
NON_COMMAND_HEADS = {"for", "select", "case", "function", "[[", "]]", "in", "esac",
                     "done", "fi", "}", "((", "))"}
PROC_ENVIRON = re.compile(r"/proc/[^/\s]*/(environ|[^/\s]*[*?\[][^/\s]*)(?:/|$)")


def check_command(command, depth=0):
    """Check a command text: the typed command, or text the shell will run
    (sh -c, eval, backticks, ((...))). Only LogicalSource reads it."""
    lexer = Lexer(LogicalSource(command), depth)
    tokens = lexer.lex_code()
    check_tokens(tokens, depth)
    for nested in lexer.nested_tokens:
        check_tokens(nested, depth + 1)
    for text in lexer.nested_texts:
        check_command(text, depth + 1)


def check_tokens(tokens, depth):
    for kind, word in tokens:
        if kind == "word" and PROC_ENVIRON.search(word.value().replace(UNKNOWN, "*")):
            raise Deny("reading /proc/<pid>/environ dumps a process environment")
    for words in simple_commands(tokens):
        check_words(words, depth)


def simple_commands(tokens):
    current, skip_target = [], False
    for kind, value in tokens:
        if skip_target and kind == "word":
            skip_target = False
            continue
        skip_target = False
        if kind == "nl" or (kind == "op" and value in SEPARATOR_OPS):
            if current:
                yield current
            current = []
        elif kind == "op":  # a redirection; its target is not an argument
            if current and current[-1].isdigit():
                current.pop()  # fd number of `2>/dev/null`
            skip_target = True
        else:
            text = value.value()
            if not value.quoted and text in ("{", "}"):
                if current:
                    yield current
                current = []
                continue
            current.append(text)
    if current:
        yield current


def unknown(word):
    return UNKNOWN in word


VARIABLE_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")


def names_a_variable(word):
    """`NAME`, `NAME=value` or `NAME[...]=value` with NAME fully known."""
    m = VARIABLE_NAME.match(word)
    return bool(m) and (m.end() == len(word) or word[m.end()] in "=[+")


def skip_options(words, i, arg_opts):
    """Index of the first operand after a wrapper's options."""
    while i < len(words):
        w = words[i]
        if w == "--":
            return i + 1
        if not w.startswith("-") or w == "-":
            return i
        i += 2 if w in arg_opts else 1
    return i


def check_text(text_words, depth):
    """Text a wrapper hands to a shell (sh -c, eval, watch, env -S)."""
    if any(unknown(w) for w in text_words):
        raise Deny("command text built from expansions cannot be inspected")
    check_command(" ".join(text_words), depth + 1)


def check_words(words, depth):
    words = list(words)
    while words:
        if ASSIGNMENT.match(words[0]):
            words.pop(0)
        elif words[0] in RESERVED_PREFIXES:
            words.pop(0)
        elif words[0] == "repeat":
            words = words[2:]
        else:
            break
    if not words or words[0] in NON_COMMAND_HEADS or unknown(words[0]):
        return  # nothing runs here, or the command name is not resolvable
    name = os.path.basename(words[0])
    args = words[1:]

    if name in {"command", "builtin", "exec", "nohup", "noglob", "caffeinate", "stdbuf"}:
        rest = skip_options(args, 0, {"-i", "-o", "-e"} if name == "stdbuf" else set())
        if name == "command" and args[:1] and args[0] in {"-v", "-V"}:
            return  # lookup only
        return check_words(args[rest:], depth)
    if name in {"sudo", "doas"}:
        return check_words(args[skip_options(args, 0, SUDO_ARG_OPTS):], depth)
    if name == "nice":
        return check_words(args[skip_options(args, 0, NICE_ARG_OPTS):], depth)
    if name == "time":
        return check_words(args[skip_options(args, 0, set()):], depth)
    if name in {"timeout", "gtimeout"}:
        j = skip_options(args, 0, TIMEOUT_ARG_OPTS)
        return check_words(args[j + 1:], depth)
    if name == "xargs":
        j = skip_options(args, 0, XARGS_ARG_OPTS)
        if j >= len(args):
            return  # xargs defaults to echo
        return check_words(args[j:], depth)
    if name == "watch":
        j = skip_options(args, 0, {"-n", "--interval", "-d"})
        return check_text(args[j:], depth)
    if name in SHELLS:
        for k, a in enumerate(args):
            if a.startswith("-") and not a.startswith("--") and "c" in a[1:]:
                if k + 1 < len(args):
                    check_text([args[k + 1]], depth)
                return
        return
    if name == "eval":
        return check_text(args, depth)
    if name == "env":
        return check_env(args, depth)
    if name == "printenv":
        if not any(VARIABLE_NAME.fullmatch(a) for a in args):
            raise Deny("`printenv` without a variable name dumps the whole environment")
        return
    if name == "export":
        if not any(names_a_variable(a) for a in args):
            raise Deny("`export -p` / bare `export` dumps every exported variable")
        return
    if name == "set":
        if not args:
            raise Deny("bare `set` dumps every shell variable")
        return
    if name in {"declare", "typeset", "readonly", "local"}:
        if not any(names_a_variable(a) for a in args):
            if name == "local" and not args:
                return  # prints only function locals
            raise Deny(f"`{name}` without a name (e.g. `declare -x`, `declare -p`) dumps variables")
        return
    if name == "ps":
        return check_ps(args)


def check_env(args, depth):
    i = 0
    empty_env = False
    while i < len(args):
        a = args[i]
        if a == "--":
            i += 1
            break
        if a in {"-i", "--ignore-environment", "-"}:
            empty_env = True
            i += 1
        elif a in ENV_ARG_OPTS:
            if a in {"-S", "--split-string"} and i + 1 < len(args):
                return check_text([args[i + 1]], depth)
            i += 2
        elif a.startswith("--") and "=" in a:
            if a.startswith("--split-string="):
                return check_text([a.split("=", 1)[1]], depth)
            i += 1
        elif a.startswith("-") and len(a) > 1:
            if "S" in a[1:]:
                rest = a[a.index("S") + 1:] or (args[i + 1] if i + 1 < len(args) else "")
                return check_text([rest], depth)
            if "i" in a[1:]:
                empty_env = True
            if a[-1] in "uPC":
                i += 2
            else:
                i += 1
        else:
            break
    while i < len(args) and (ASSIGNMENT.match(args[i]) or unknown(args[i])):
        i += 1
    if i >= len(args):
        if empty_env:
            return
        raise Deny("`env` without a command dumps the whole environment")
    return check_words(args[i:], depth)


def check_ps(args):
    skip = False
    for k, a in enumerate(args):
        if skip:
            skip = False
            continue
        if a.startswith("--"):
            if a in {"--sort", "--format", "--pid", "--ppid", "--user", "--group", "--cols", "--rows"}:
                skip = True
            continue
        dashed = a.startswith("-")
        letters = a[1:] if dashed else a
        if not letters or not letters.isalpha():
            continue  # pids, field lists, etc.
        for idx, ch in enumerate(letters):
            if dashed and ch == "E":
                raise Deny("`ps -E` prints every listed process's environment")
            if not dashed and ch == "e":
                raise Deny("BSD-style `ps e` (e.g. `ps eww`, `ps auxe`) prints process environments")
            if ch in (PS_ARG_LETTERS if dashed else PS_BSD_ARG_LETTERS):
                if idx == len(letters) - 1:
                    skip = True
                break  # the rest of the cluster is this option's argument


def decision(reason):
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": f"agent-env-guard: {reason}. {SAFE_HINT}",
        }
    }


def main():
    try:
        payload = json.load(sys.stdin)
    except (ValueError, UnicodeDecodeError):
        # Fail closed and visibly; never echo the input.
        json.dump(decision("could not parse the hook input, so the command was not inspected"), sys.stdout)
        return 0
    tool_input = payload.get("tool_input") if isinstance(payload, dict) else None
    command = tool_input.get("command") if isinstance(tool_input, dict) else None
    if isinstance(command, list):
        command = shlex.join(str(c) for c in command)
    if not isinstance(command, str) or command == "":
        return 0
    try:
        check_command(command)
    except Deny as denied:
        json.dump(decision(str(denied)), sys.stdout)
    except Exception as error:  # a guard bug must not silently allow
        json.dump(decision(f"internal error ({type(error).__name__}), command not inspected"), sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
