#!/usr/bin/env python3
"""PreToolUse command guard for Claude Code and Codex.

Denies shell commands that dump a whole environment or list processes with
their environments:

  * ps with an environment flag: -E in a dash cluster (macOS), or e in a
    BSD-style cluster without a dash (ps eww, ps auxe, ps axe)
  * bare env / printenv, env with only options or assignments and no command
  * export -p, bare export, bare set, declare/typeset/readonly with no name
    (declare -x, declare -p, typeset -x, readonly -p)
  * any read of /proc/<pid>/environ

It allows ordinary ps (ps aux, ps -ef, ps -o pid,command -p 123),
printenv NAME, export NAME=value, set -euo pipefail, declare -p NAME, and
env NAME=value command ... / env -u NAME command ... (the wrapped command is
still checked).

LIMITATION: this guard inspects only the command line the agent typed. It
cannot see what a test, script, build tool or interpreter (node, python,
ruby, ...) does once it runs, so a program that reads process environments
internally is NOT stopped by it, and indirection such as `p=ps; $p -E` or
building the command inside a script gets past it. Shell syntax is read by
the lexing contract below; forms outside it are not modelled. Pair it with the subprocess environment
scrub and with keeping secrets out of exported shell variables.

Input: the hook JSON on stdin ({"tool_name": "Bash", "tool_input":
{"command": "..."}}). Output: a PreToolUse deny decision on stdout (exit 0)
or nothing (allow). Deny messages name the matched form and the safe
alternative; they never echo the command text, so a value typed on the
command line cannot leak through the hook output.
"""

import json
import os
import re
import shlex
import sys

SAFE_HINT = (
    "Read a single variable with `printenv NAME` (or `[ -n \"${NAME+x}\" ]` to "
    "test presence), list processes without environments (`ps -o pid,ppid,command`), "
    "and pass values with `env NAME=value command`."
)

PUNCTUATION = set(";&|()<>\n")
REDIRECTS = {"<", ">", ">>", "<<", "<<<", "<&", ">&", "<>", ">|", "&>", "&>>"}
SHELLS = {"sh", "bash", "zsh", "dash", "ksh", "fish"}
# Options that take a separate argument, per wrapper.
SUDO_ARG_OPTS = {"-u", "-g", "-C", "-D", "-h", "-p", "-R", "-T", "-U", "-r", "-t"}
NICE_ARG_OPTS = {"-n"}
XARGS_ARG_OPTS = {"-E", "-I", "-J", "-L", "-n", "-P", "-R", "-S", "-s", "-d", "-a"}
TIMEOUT_ARG_OPTS = {"-s", "-k", "--signal", "--kill-after"}
ENV_ARG_OPTS = {"-u", "-S", "-P", "-C", "--unset", "--chdir", "--split-string"}
# ps options (macOS and procps) that consume the following token, in dash
# clusters (`-o pid`) and in BSD-style clusters without a dash (`axo pid`).
PS_ARG_LETTERS = set("GgMNOoptUuDkq")
PS_BSD_ARG_LETTERS = set("OoptUk")

PROC_ENVIRON = re.compile(r"/proc/[^\s'\"]*/environ")
ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?\+?=")
WORD_END = set(" \t\n;&|<>()")
CONTINUATION = "\\\n"
# Stands in for a command substitution in the code handed to the word checks;
# its value is unknown, so it never counts as a variable name or a command.
SUBSTITUTED = "\x00substitution\x00"

# ---------------------------------------------------------------------------
# Shell lexing support contract
#
# The guard decides on shell code only after splitting the typed command the
# way POSIX sh and bash do for the subset below. Every executable form outside
# it that the guard cannot resolve is denied, never allowed.
#
# L1 Quoting. Single quotes are literal (a backslash-newline inside them stays).
#    Double quotes are literal except for `$(...)`, backticks and backslash.
#    A backslash outside single quotes escapes the next character.
# L2 Line continuation. Backslash-newline outside single quotes is removed
#    before anything else is read, so it joins words, operators, here-document
#    delimiters (`<<EO\<newline>F` is `<<EOF`) and command names
#    (`en\<newline>v` is `env`).
# L3 Comments. `#` at the start of an unquoted word comments out the rest of
#    the physical line; a comment has no continuation and no operators.
# L4 Here-string. `<<<` is one operator; its word is ordinary code, so the
#    substitutions in it are inspected.
# L5 Here-document. `<<word` or `<<-word` (not `<<<`) in unquoted code. The
#    delimiter is the word after L2 and quote removal; it is quoted when the
#    word contains any quote character or backslash. The body starts after
#    the next newline in code; several here-documents on one line take their
#    bodies in order.
#    - `<<-` removes leading tabs from each physical body line.
#    - Quoted delimiter: body lines are compared physically and the body is
#      literal data, not inspected.
#    - Unquoted delimiter: a line ending in an unescaped backslash continues
#      onto the next line (L2) before it is compared with the delimiter, and
#      every `$(...)` and backtick in the body is inspected. Quotes are
#      literal characters in a body.
#    - A body without its delimiter runs to the end of the command.
# L6 Arithmetic. In `((...))` at the start of a word and in `$((...))`, `<<`
#    is a shift, not a here-document. Substitutions inside are inspected; a
#    multi-line arithmetic expression is denied.
# L7 Command substitution. `$(...)` is matched by quote-aware parenthesis
#    counting, backticks by the next unescaped backtick; each body is
#    inspected with all rules, recursively.
# L8 Refusal. An unterminated substitution, a here-document without a
#    parseable delimiter, multi-line arithmetic and nesting deeper than 8 are
#    denied visibly.
#
# Not modelled (outside the contract): `case` patterns with `)` inside
# `$(...)` and here-documents inside `$(...)` are counted as code; a mismatch
# there only makes more text count as code, or is denied as unterminated.
# Aliases, functions, variable indirection (`p=ps; $p -E`) and anything a
# program does after it starts are not seen at all.
# ---------------------------------------------------------------------------


class Deny(Exception):
    """A denied form; the message is safe to show (no command text)."""


def close_paren(text, i):
    """Index of the `)` closing a `(` whose content starts at text[i] (L7)."""
    depth, state, n = 1, None, len(text)
    while i < n:
        c = text[i]
        if state == "'":
            if c == "'":
                state = None
        elif c == "\\":
            i += 1
        elif c == "`":
            i = close_backtick(text, i + 1)
        elif text.startswith("$(", i):
            i = close_paren(text, i + 2)
        elif state == '"':
            if c == '"':
                state = None
        elif c in "'\"":
            state = c
        elif c == "(":
            depth += 1
        elif c == ")":
            depth -= 1
            if depth == 0:
                return i
        i += 1
    raise Deny("an unterminated command substitution cannot be inspected")


def close_backtick(text, i):
    """Index of the backtick closing one whose body starts at text[i] (L7)."""
    n = len(text)
    while i < n:
        if text[i] == "\\":
            i += 2
            continue
        if text[i] == "`":
            return i
        i += 1
    raise Deny("an unterminated backtick substitution cannot be inspected")


def literal_text_substitutions(text):
    """`$(...)` and backtick bodies in text whose quotes are literal (L5, L6)."""
    subs, i, n = [], 0, len(text)
    while i < n:
        c = text[i]
        if c == "\\":
            i += 2
            continue
        if text.startswith("$(", i):
            end = close_paren(text, i + 2)
            subs.append(text[i + 2:end])
            i = end + 1
        elif c == "`":
            end = close_backtick(text, i + 1)
            subs.append(text[i + 1:end])
            i = end + 1
        else:
            i += 1
    return subs


def arithmetic_substitutions(expression):
    if "\n" in expression.replace(CONTINUATION, ""):
        raise Deny("a multi-line arithmetic expression cannot be inspected")
    return literal_text_substitutions(expression)


def skip_continuations(text, i):
    while text.startswith(CONTINUATION, i):
        i += 2
    return i


def read_word(text, i):
    """A shell word from text[i] with L2 applied, and the index after it."""
    word, state, n = [], None, len(text)
    while i < n:
        if state != "'" and text.startswith(CONTINUATION, i):
            i += 2
            continue
        c = text[i]
        if state:
            if c == state:
                state = None
            elif c == "\\" and state == '"' and i + 1 < n:
                word.append(text[i:i + 2])
                i += 2
                continue
        elif c == "\\" and i + 1 < n:
            word.append(text[i:i + 2])
            i += 2
            continue
        elif c in "'\"":
            state = c
        elif c in WORD_END:
            break
        word.append(c)
        i += 1
    return "".join(word), i


def unescaped_trailing_backslash(line):
    stripped = line.rstrip("\\")
    return (len(line) - len(stripped)) % 2 == 1


def read_heredoc_body(text, i, delimiter, strip_tabs, quoted):
    """Body of a here-document from text[i] (L5), and the index after it."""
    body, n = [], len(text)
    while i < n:
        end = text.find("\n", i)
        line = text[i:] if end < 0 else text[i:end]
        i = n if end < 0 else end + 1
        if strip_tabs:
            line = line.lstrip("\t")
        if not quoted:
            while unescaped_trailing_backslash(line) and i < n:
                end = text.find("\n", i)
                more = text[i:] if end < 0 else text[i:end]
                i = n if end < 0 else end + 1
                line = line[:-1] + (more.lstrip("\t") if strip_tabs else more)
        if line == delimiter:
            break
        body.append(line)
    return "\n".join(body), i


def scan(command):
    """Shell code of a command (here-document bodies removed, L2 applied) and
    every command-substitution body the shell would run, per the contract."""
    code, subs, pending = [], [], []
    state, word_start, i, n = None, True, 0, len(command)
    while i < n:
        c = command[i]
        if state == "'":
            code.append(c)
            if c == "'":
                state = None
            i += 1
            continue
        if command.startswith(CONTINUATION, i):  # L2
            i += 2
            continue
        if c == "\\":
            code.append(command[i:i + 2])
            i += 2
            word_start = False
            continue
        if command.startswith("$(", i):
            end = close_paren(command, i + 2)
            if command.startswith("$((", i) and command[end - 1] == ")":  # L6
                subs.extend(arithmetic_substitutions(command[i + 3:end - 1]))
                code.append("0")
            else:  # L7
                subs.append(command[i + 2:end])
                code.append(SUBSTITUTED)
            i, word_start = end + 1, False
            continue
        if c == "`":
            end = close_backtick(command, i + 1)
            subs.append(command[i + 1:end])
            code.append(SUBSTITUTED)
            i, word_start = end + 1, False
            continue
        if state == '"':
            code.append(c)
            if c == '"':
                state = None
            i += 1
            continue
        if c in "'\"":
            state, word_start = c, False
            code.append(c)
            i += 1
            continue
        if c == "#" and word_start:  # L3
            end = command.find("\n", i)
            i = n if end < 0 else end
            continue
        if word_start and command.startswith("((", i):  # L6
            end = close_paren(command, i + 1)
            if command[end - 1] == ")":
                expression = command[i + 2:end - 1]
                arithmetic_substitutions(expression)  # refuses multi-line
                # dash reads `((...))` as nested subshells, so the content is
                # also checked as code.
                subs.append(expression)
                code.append("true")
                i, word_start = end + 1, False
                continue
        if command.startswith("<<<", i):  # L4
            code.append("<<<")
            i, word_start = i + 3, True
            continue
        if command.startswith("<<", i):  # L5
            j = skip_continuations(command, i + 2)
            strip_tabs = j < n and command[j] == "-"
            j = skip_continuations(command, j + strip_tabs)
            while j < n and command[j] in " \t":
                j = skip_continuations(command, j + 1)
            word, j = read_word(command, j)
            if not word:
                raise Deny("a here-document without a delimiter cannot be inspected")
            try:
                delimiter = "".join(shlex.split(word))
            except ValueError:
                raise Deny("a here-document delimiter that cannot be parsed cannot be inspected")
            quoted = any(q in word for q in "'\"\\")
            pending.append((delimiter, strip_tabs, quoted))
            code.append("<< _")
            i, word_start = j, False
            continue
        if c == "\n":
            code.append(c)
            i, word_start = i + 1, True
            for delimiter, strip_tabs, quoted in pending:
                body, i = read_heredoc_body(command, i, delimiter, strip_tabs, quoted)
                if not quoted:
                    subs.extend(literal_text_substitutions(body))
            pending = []
            continue
        word_start = c in " \t;&|()<>"
        code.append(c)
        i += 1
    return "".join(code), subs


def tokenize(command):
    lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|()<>\n")
    lexer.whitespace = " \t\r"
    lexer.whitespace_split = True
    lexer.commenters = ""  # `#` also appears in ${#var}; never drop text
    return list(lexer)


def simple_commands(tokens):
    current = []
    skip_next = False
    for tok in tokens:
        if skip_next:
            skip_next = False
            continue
        if tok in REDIRECTS:
            if current and current[-1].isdigit():
                current.pop()  # fd number of `2>/dev/null`, not an argument
            skip_next = True  # the redirect target is not an argument
        elif tok and set(tok) <= PUNCTUATION:
            # `;`, `&&`, `|`, and runs such as `)|` or `;\n` end a command
            if current:
                yield current
            current = []
        else:
            current.append(tok)
    if current:
        yield current


def check_command(command, depth=0):
    if depth > 8:
        raise Deny("command nesting is too deep to inspect")
    if PROC_ENVIRON.search(command) or PROC_ENVIRON.search(command.replace(CONTINUATION, "")):
        raise Deny("reading /proc/<pid>/environ dumps a process environment")
    command, substitutions = scan(command)
    for inner in substitutions:
        check_command(inner, depth + 1)
    try:
        tokens = tokenize(command)
    except ValueError:
        # Unbalanced quoting: the shell would reject it too. Fall back to a
        # whitespace split so obvious forms are still caught.
        tokens = command.replace(";", " ; ").replace("|", " | ").split()
    for words in simple_commands(tokens):
        check_words(words, depth)


def skip_options(words, i, arg_opts):
    """Index of the first operand after a wrapper's options."""
    while i < len(words):
        w = words[i]
        if w == "--":
            return i + 1
        if not w.startswith("-") or w == "-":
            return i
        i += 2 if w in arg_opts else 1
    return i


def check_words(words, depth):
    i = 0
    while i < len(words) and ASSIGNMENT.match(words[i]):
        i += 1
    if i >= len(words):
        return
    name = os.path.basename(words[i])
    args = words[i + 1:]

    if name in {"command", "builtin", "exec", "nohup", "noglob", "caffeinate", "stdbuf"}:
        rest = skip_options(args, 0, {"-i", "-o", "-e"} if name == "stdbuf" else set())
        if name == "command" and args[:1] and args[0] in {"-v", "-V"}:
            return  # lookup only
        return check_words(args[rest:], depth)
    if name in {"sudo", "doas"}:
        return check_words(args[skip_options(args, 0, SUDO_ARG_OPTS):], depth)
    if name == "nice":
        return check_words(args[skip_options(args, 0, NICE_ARG_OPTS):], depth)
    if name == "time":
        return check_words(args[skip_options(args, 0, set()):], depth)
    if name in {"timeout", "gtimeout"}:
        j = skip_options(args, 0, TIMEOUT_ARG_OPTS)
        return check_words(args[j + 1:], depth)
    if name == "xargs":
        j = skip_options(args, 0, XARGS_ARG_OPTS)
        if j >= len(args):
            return  # xargs defaults to echo
        return check_words(args[j:], depth)
    if name == "watch":
        j = skip_options(args, 0, {"-n", "--interval", "-d"})
        return check_command(" ".join(args[j:]), depth + 1)
    if name in SHELLS:
        for k, a in enumerate(args):
            if a.startswith("-") and not a.startswith("--") and "c" in a[1:]:
                if k + 1 < len(args):
                    check_command(args[k + 1], depth + 1)
                return
        return
    if name == "eval":
        return check_command(" ".join(args), depth + 1)
    if name == "env":
        return check_env(args, depth)
    if name == "printenv":
        if not [a for a in args if not a.startswith("-") and a != SUBSTITUTED]:
            raise Deny("`printenv` without a variable name dumps the whole environment")
        return
    if name == "export":
        if not args or all(a.startswith("-") or a == SUBSTITUTED for a in args):
            raise Deny("`export -p` / bare `export` dumps every exported variable")
        return
    if name == "set":
        if not args:
            raise Deny("bare `set` dumps every shell variable")
        return
    if name in {"declare", "typeset", "readonly", "local"}:
        if not [a for a in args if not a.startswith(("-", "+")) and a != SUBSTITUTED]:
            if name == "local" and not args:
                return  # prints only function locals
            raise Deny(f"`{name}` without a name (e.g. `declare -x`, `declare -p`) dumps variables")
        return
    if name == "ps":
        return check_ps(args)


def check_env(args, depth):
    i = 0
    empty_env = False
    while i < len(args):
        a = args[i]
        if a == "--":
            i += 1
            break
        if a in {"-i", "--ignore-environment", "-"}:
            empty_env = True
            i += 1
        elif a in ENV_ARG_OPTS:
            if a in {"-S", "--split-string"} and i + 1 < len(args):
                return check_command(args[i + 1], depth + 1)
            i += 2
        elif a.startswith("--") and "=" in a:
            if a.startswith("--split-string="):
                return check_command(a.split("=", 1)[1], depth + 1)
            i += 1
        elif a.startswith("-") and len(a) > 1:
            if "S" in a[1:]:
                rest = a[a.index("S") + 1:] or (args[i + 1] if i + 1 < len(args) else "")
                return check_command(rest, depth + 1)
            if "i" in a[1:]:
                empty_env = True
            if a[-1] in "uPC":
                i += 2
            else:
                i += 1
        else:
            break
    while i < len(args) and (ASSIGNMENT.match(args[i]) or args[i] == SUBSTITUTED):
        i += 1
    if i >= len(args):
        if empty_env:
            return
        raise Deny("`env` without a command dumps the whole environment")
    return check_words(args[i:], depth)


def check_ps(args):
    skip = False
    for k, a in enumerate(args):
        if skip:
            skip = False
            continue
        if a.startswith("--"):
            if a in {"--sort", "--format", "--pid", "--ppid", "--user", "--group", "--cols", "--rows"}:
                skip = True
            continue
        dashed = a.startswith("-")
        letters = a[1:] if dashed else a
        if not letters or not letters.isalpha():
            continue  # pids, field lists, etc.
        for idx, ch in enumerate(letters):
            if dashed and ch == "E":
                raise Deny("`ps -E` prints every listed process's environment")
            if not dashed and ch == "e":
                raise Deny("BSD-style `ps e` (e.g. `ps eww`, `ps auxe`) prints process environments")
            if ch in (PS_ARG_LETTERS if dashed else PS_BSD_ARG_LETTERS):
                if idx == len(letters) - 1:
                    skip = True
                break  # the rest of the cluster is this option's argument


def decision(reason):
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": f"agent-env-guard: {reason}. {SAFE_HINT}",
        }
    }


def main():
    try:
        payload = json.load(sys.stdin)
    except (ValueError, UnicodeDecodeError):
        # Fail closed and visibly; never echo the input.
        json.dump(decision("could not parse the hook input, so the command was not inspected"), sys.stdout)
        return 0
    tool_input = payload.get("tool_input") if isinstance(payload, dict) else None
    command = tool_input.get("command") if isinstance(tool_input, dict) else None
    if isinstance(command, list):
        command = shlex.join(str(c) for c in command)
    if not isinstance(command, str) or not command.strip():
        return 0
    try:
        check_command(command)
    except Deny as denied:
        json.dump(decision(str(denied)), sys.stdout)
    except Exception as error:  # a guard bug must not silently allow
        json.dump(decision(f"internal error ({type(error).__name__}), command not inspected"), sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
