#!/usr/bin/env bash
set -euo pipefail

SANDBOX="${1:-}"
AGENT="${2:-}"

if [[ -z "$SANDBOX" || -z "$AGENT" ]]; then
  echo "Usage: $0 <sandbox-name> <codex|claude>"
  exit 1
fi

REMOTE_HOME="$(sbx exec "$SANDBOX" -- sh -lc 'printf "%s" "$HOME"')"

disable_unsupported_codex_mcp() {
  sbx exec "$SANDBOX" -- sh -lc '
    python3 - <<PY
from pathlib import Path
import re

p = Path.home() / ".codex/config.toml"

if p.exists():
    s = p.read_text()

    for name in ["node_repl", "MCP_DOCKER"]:
        s = re.sub(
            rf"\n?\[mcp_servers\.{re.escape(name)}\][\s\S]*?(?=\n\[[^\]]+\]|\Z)",
            f"\n# {name} disabled in Docker Sandbox\n",
            s,
        )

        s = re.sub(
            rf"\n?\[mcp_servers\.{re.escape(name)}\.env\][\s\S]*?(?=\n\[[^\]]+\]|\Z)",
            "\n",
            s,
        )

    p.write_text(s)
PY
  '
}

detect_sandbox_workdir() {
  touch .sbx_probe

  sbx exec "$SANDBOX" -- sh -lc '
    dirname "$(find / -name .sbx_probe 2>/dev/null | head -1)"
  '
}

# sync_dir_via_workspace_tar <src> <dest> <name> <mode> [tar --exclude patterns...]
#   replace: the sandbox dir is wiped and replaced by the archive (symlinks
#            travel as symlinks).
#   merge:   symlinks are dereferenced on the host and only the top-level
#            entries present in the archive are replaced in the sandbox, so
#            state the sandbox wrote itself (auth, sessions) survives.
sync_dir_via_workspace_tar() {
  local src="$1"
  local dest="$2"
  local name="$3"
  local mode="$4"
  shift 4
  local extra_excludes=("$@")

  local real_src
  local sandbox_workdir
  local archive_name
  local host_archive
  local sandbox_archive

  if [[ ! -e "$src" ]]; then
    echo "Skipping missing path: $src"
    return 0
  fi

  real_src="$(realpath "$src")"

  if [[ ! -d "$real_src" ]]; then
    echo "Skipping non-directory path: $src -> $real_src"
    return 0
  fi

  sandbox_workdir="$(detect_sandbox_workdir)"

  if [[ -z "$sandbox_workdir" || "$sandbox_workdir" == "." ]]; then
    echo "Could not detect sandbox workdir"
    exit 1
  fi

  archive_name=".${name}-$(date +%s).tar"
  host_archive="./$archive_name"
  sandbox_archive="$sandbox_workdir/$archive_name"

  echo "Syncing $src -> $real_src -> $SANDBOX:$dest"

  rm -f "$host_archive"

  local tar_flags=(-cf "$host_archive")
  [[ "$mode" == merge ]] && tar_flags=(-h "${tar_flags[@]}")

  TAR_CMD="$(command -v gtar || command -v tar)"
  COPYFILE_DISABLE=1 "$TAR_CMD" \
    --exclude='._*' \
    --exclude='.DS_Store' \
    --exclude='__MACOSX' \
    --exclude='.codex' \
    --exclude='.tmp' \
    --exclude='vendor_imports' \
    ${extra_excludes[@]+"${extra_excludes[@]/#/--exclude=}"} \
    -C "$real_src" \
    "${tar_flags[@]}" .

  if [[ "$mode" == merge ]]; then
    sbx exec "$SANDBOX" -- sh -lc "
      mkdir -p '$dest'
      tar -tf '$sandbox_archive' | sed -n 's#^\./\([^/][^/]*\).*#\1#p' | sort -u | while IFS= read -r top; do
        rm -rf \"$dest/\$top\"
      done
      tar -C '$dest' -xf '$sandbox_archive'
      rm -f '$sandbox_archive'
    "
  else
    sbx exec "$SANDBOX" -- sh -lc "
      rm -rf '$dest'
      mkdir -p '$dest'
      tar -C '$dest' -xf '$sandbox_archive'
      rm -f '$sandbox_archive'
    "
  fi

  rm -f "$host_archive"
}

case "$AGENT" in
  codex)
    # ~/.codex is Codex's native home on both ends. Only config is synced:
    # the repo links install.sh created (dereferenced into real copies) and
    # config.toml; machine state - sessions, sqlite databases, logs, history,
    # auth, caches, plugins, memories, runtime sockets and locks - stays out,
    # and the sandbox keeps its own.
    sync_dir_via_workspace_tar "$HOME/.codex" "$REMOTE_HOME/.codex" "codex-home" merge \
      './sessions' './archived_sessions' './log' './logs' './history.jsonl' './auth.json' \
      './sqlite' './*.sqlite' './*.sqlite-shm' './*.sqlite-wal' \
      './session_index.jsonl' './*history*' './dictation-history' './shell_snapshots' \
      './tmp' './ipc' './installation_id' './.codex-global-state.json*' './..codex-global-state*' \
      './cache' './plugins' './memories' './process_manager' './thread-writer-locks'
    disable_unsupported_codex_mcp

    sbx exec "$SANDBOX" -- sh -lc '
      echo "HOME=$HOME"

      echo "Skills path:"
      ls -la "$HOME/.codex/skills"

      echo "Detected skills:"
      find "$HOME/.codex/skills" -maxdepth 2 -name SKILL.md | sort | head -50

      command -v codex
      codex --version
    '
    ;;

  claude)
    # ~/.claude is Claude Code's native home (real directory, repo links inside).
    sync_dir_via_workspace_tar "$HOME/.claude" "$REMOTE_HOME/.claude" "claude-home" replace

    sbx exec "$SANDBOX" -- sh -lc '
      command -v claude
      claude --version
    '
    ;;

  *)
    echo "Unsupported agent: $AGENT"
    echo "Usage: $0 <sandbox-name> <codex|claude>"
    exit 1
    ;;
esac

echo "Done."
