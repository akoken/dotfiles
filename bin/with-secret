#!/usr/bin/env bash
#
# with-secret <item> <VAR> <command> [args...]
#
# Run one command with one secret in its environment:
#
#   with-secret xai XAI_API_KEY grok "$@"
#
# Fetches the item with `secret-get`, sets VAR in this process only and execs
# the command, so the value reaches exactly that command and its children and
# never the calling shell. The other managed agent keys and the 1Password
# service account token are removed from the command's environment. Nothing
# is exported to the caller, nothing is printed, and the value never appears
# on any command line. If the secret cannot be read, the command is not
# started and this exits non-zero.
# See README "Agent keys".

# A caller's exported SHELLOPTS=xtrace (or `bash -x`) would trace every
# assignment below, secrets included. Turn tracing off before anything else.
set +x
set -Eeuo pipefail

fail() {
  echo "with-secret: $1" >&2
  exit "${2:-1}"
}

[ "$#" -ge 3 ] || fail "usage: with-secret <item> <VAR> <command> [args...]" 2
item="$1"
var="$2"
shift 2

case "$var" in
  '' | [0-9]* | *[!A-Za-z0-9_]*) fail "invalid variable name" 2 ;;
esac

# Prefer the secret-get that ships next to this script, so a host that starts
# this by absolute path with a minimal PATH still finds it.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
getter="$here/secret-get"
[ -x "$getter" ] || getter="secret-get"

# A `value` the caller exported would keep its export attribute through the
# assignment below and hand the key to the command under that name too;
# unset it first so the temporary is a plain shell variable.
unset value
value="$("$getter" "$item")" || exit 1

# Hand the consumer its one key only: drop every managed key and the service
# account token that the calling environment may still carry (for example a
# session started while the keys were still exported globally). The target
# is exported last, so it may share a name with any variable of this script;
# `value` itself is never exported unless it is the target, and exec drops
# every other shell variable.
unset CONTEXT7_API_KEY OBSS_LLM_API_KEY OPENROUTER_API_KEY XAI_API_KEY JIRA_API_TOKEN \
  OP_SERVICE_ACCOUNT_TOKEN
export "$var=$value"
exec "$@"
