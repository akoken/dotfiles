# MacOS
.DS_Store
session.json

# Tmux Plugins
**/tmux/plugins

# Zsh Extensions
**/zsh/.zcompdump*
**/zsh/.zcompcache
**/zsh/.zsh_history
**/zsh/.zsh_sessions

config/nvim/lazy-lock.json
config/.copilot/config.json
*.bak

# Codex
/config/codex/*
!/config/codex/*config.toml
!/config/codex/agents/
!/config/codex/skills/
!/config/codex/.codexignore
/config/codex/skills/.system/
# config.local.toml already falls under the /config/codex/* rule above (it
# doesn't match the *config.toml exception, verified with `git check-ignore`)
# but is listed explicitly so the exception line above can't silently start
# matching it if it's ever edited.
/config/codex/config.local.toml
!/config/codex/config.local.toml.example

# OpenCode
node_modules/
**/opencode/package.json 
**/opencode/package-lock.json
**/opencode/plugins
**/opencode/herdr-tui-session.js
**/opencode/tui.jsonc

# Herdr
/config/herdr/*
!config/herdr/config.toml
