# Per-command API key wrappers (sourced by .zshrc; POSIX function syntax so
# tests/agent-keys.sh can also load it under bash).
#
# Each wrapper fetches exactly one key from the 1Password `agent-keys` vault
# at call time and passes it to exactly one command through `with-secret`.
# Nothing here exports a key into the interactive shell, so agent sessions
# started from this shell do not inherit any of them. See README "Agent keys"
# for adding a key and for the residual risks.

# Grok CLI reads XAI_API_KEY when it has no active session token.
grok() { with-secret xai XAI_API_KEY grok "$@"; }

# jira-cli reads JIRA_API_TOKEN.
jira() { with-secret jira JIRA_API_TOKEN jira "$@"; }

# Qwen Code reads the key from the variable its provider config names
# (`envKey`). One wrapper per provider, so a session holds only one key:
# `qwen` gets the OBSS LLM key, `qwen-or` the OpenRouter key. `qwen-or`
# picks the key only, not the model: choose the OpenRouter model explicitly
# at startup. To switch provider, restart through the other wrapper.
qwen() { with-secret obss-llm OBSS_LLM_API_KEY qwen "$@"; }
qwen-or() { with-secret openrouter OPENROUTER_API_KEY qwen "$@"; }

# Copilot CLI with the OBSS LLM endpoint as its custom (BYOK) provider.
# Copilot reads the key from COPILOT_PROVIDER_API_KEY, not OBSS_LLM_API_KEY.
# The wrapper selects the provider and its key, not the model: choose the
# model at startup (`--model` or COPILOT_MODEL). Plain `copilot` is left
# alone and keeps GitHub Copilot's own model routing. The two non-secret
# provider variables go through `env` so they reach only this one command:
# a prefix assignment on a function call is unspecified by POSIX and stays
# in the calling shell under some shells (macOS /bin/sh).
copilot-obss() {
  env COPILOT_PROVIDER_TYPE=openai COPILOT_PROVIDER_BASE_URL=https://ai.obss.tech/llm/v1 \
    with-secret obss-llm COPILOT_PROVIDER_API_KEY copilot "$@"
}

# Ad-hoc consumers without a dedicated CLI: prefix any one command, e.g.
#   with-openrouter python agent/main.py
#   with-obss-llm ./run-eval.sh
with-openrouter() { with-secret openrouter OPENROUTER_API_KEY "$@"; }
with-obss-llm() { with-secret obss-llm OBSS_LLM_API_KEY "$@"; }
