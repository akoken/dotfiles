
#!/usr/bin/env zsh
#
g() {
  if [[ $# > 0 ]]; then
      # if there are arguments, send them to git
      git $@
  else
      # otherwise, run git status
      git s
  fi
}

gwtc() { git-create-worktree "$@"; }

last_modified() {
  ls -lt $1 | head -n 2 | tail -n 1 | awk '{print $6, $7, $8}'
}

md() {
  mkdir -p $1
  cd $1
}

prepend_path() {
  [[ ! -d "$1" ]] && return

  path=(
      $1
      $path
  )
}

docker() {
    case "$1" in
        "open")
            echo "Opening the Docker app..."
            open --background -a Docker
            ;;
        "close")
            echo "Stopping currently running Docker containers..."
            command docker ps -q | xargs -r -L1 command docker stop
            if [ $? -eq 0 ]; then
                echo "Closing the Docker app..."
                test -z "$(command docker ps -q 2>/dev/null)" && osascript -e 'quit app "Docker"'
            else
                echo "Failed to stop containers."
            fi
            ;;
        "flush")
            echo "Stopping and removing all containers."
            command docker container stop $(command docker ps -a -q) && command docker container rm $(command docker ps -a -q)
            if [ $? -eq 0 ]; then
                echo "Done."
            else
                echo "Failed to flush containers."
            fi
            ;;
        *)
            command docker "$@"
            ;;
    esac
}

# Local Coding Server and Client

_local_coding_model_file() {
    print -r -- "${XDG_STATE_HOME:-$HOME/.local/state}/local-coding/current-model"
}

lcs() {
    if [[ -z "$1" ]]; then
        echo "Usage: lcs <model-path>" >&2
        return 1
    fi

    local model_path="${1/#\~/$HOME}"
    local model_name="${model_path##*/}"
    local model_state_file="$(_local_coding_model_file)"

    model_name="${model_name%.gguf}"
    model_name="${model_name%.mlx}"

    export LOCAL_CODING_MODEL="$model_name"

    command mkdir -p "${model_state_file:h}" || return 1
    print -r -- "$LOCAL_CODING_MODEL" >| "$model_state_file" || return 1

    # Pass the key explicitly: llama-server otherwise falls back to whatever
    # LLAMA_API_KEY the launching shell happens to carry, and a stale shell
    # then enforces a key no current client knows.
    llama-server --model "$model_path" \
     --api-key "${LOCAL_API_KEY}" \
     --n-gpu-layers 99 --ctx-size 128000 --flash-attn on \
     --batch-size 512 --threads 8 --temp 0.6 --min-p 0.05 \
     --top-p 0.95 --top-k 40 --spec-type draft-mtp \
     --spec-draft-n-max 2 --host 127.0.0.1 --port 8081

    local status=$?

    command rm -f "$model_state_file"

    return $status
}

unalias ccl 2>/dev/null

ccl() {
    export ANTHROPIC_BASE_URL=http://localhost:8080

    # Bypass the need to have an Anthropic login
    export ANTHROPIC_AUTH_TOKEN="$LOCAL_API_KEY"

    # Turn off telemetry shit
    export BETA_TRACING_ENDPOINT=http://127.0.0.1/fakebullshituri
    export ENABLE_ENHANCED_TELEMETRY_BETA=0
    export CLAUDE_CODE_ENABLE_TELEMETRY=0
    export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
    export DISABLE_TELEMETRY=1

    local model_state_file="$(_local_coding_model_file)"
    local model_name="$LOCAL_CODING_MODEL"

    if [[ -r "$model_state_file" ]]; then
        IFS= read -r model_name < "$model_state_file"
        export LOCAL_CODING_MODEL="$model_name"
    fi

    if [[ -z "$model_name" ]]; then
        echo "LOCAL_CODING_MODEL is not set. Run 'lcs <model>' first." >&2
        return 1
    fi

    claude --model "$model_name" "$@"
}

cpl() {
    export COPILOT_PROVIDER_TYPE="openai"
    export COPILOT_PROVIDER_BASE_URL="http://127.0.0.1:8080/v1"
    export COPILOT_MODEL="Qwen3.6-35B-A3B-UD-Q8_K_XL.gguf"
    export COPILOT_PROVIDER_WIRE_API="completions"

    copilot
}

