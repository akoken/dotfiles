#!/usr/bin/env zsh
#
# Template for ~/.zsh_functions.local — machine-only shell functions that
# assume local paths/tools not every checkout of this repo has (a specific
# project directory, a venv, a model server not in the Brewfile). Copy this
# file to ~/.zsh_functions.local (outside the repo, never tracked) and adapt
# it; .zsh_functions sources it automatically if present.

q36_mlx() {
    cd ~/mlx_projects
    source ~/dflash-serve/bin/activate

    # Qwen3.6-35B-A3B MoE — ~85.5 tok/s
    dflash serve --model mlx-community/Qwen3.6-35B-A3B-8bit \
      --draft-quant none --verify-mode dflash --verify-len-cap 6 \
      --chat-template-args '{"reasoning_effort":"xhigh"}' \
      --copyspec-mode auto --port 8081
}

q38_mlx() {
    cd ~/mlx_projects
    source ~/dflash-serve/bin/activate

    # Qwen3.8-27B dense — ~32 tok/s (baseline 20.4, 1.6x)
    dflash serve \
      --model mlx-community/Qwen3.8-27B-4bit \
      --draft z-lab/Qwen3.8-27B-DFlash2 \
      --draft-quant none \
      --verify-mode dflash --verify-len-cap 4 \
      --copyspec-mode auto \
      --chat-template-args '{"reasoning_effort":"low"}' \
      --port 8081
}
