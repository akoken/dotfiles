{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/default_model",
  "small_model": "llamacpp/default_model",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LlamaCpp (local)",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "default_model": {
          "name": "Qwen 3.6 35B A3B"
        }
      }
    },
    "mlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX (local)",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "default_model": {
          "name": "Qwen 3.6 35B A3B"
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec \"$HOME/bin/with-secret\" context7 CONTEXT7_API_KEY npx -y @upstash/context7-mcp"
      ],
      "enabled": true
    },
    "MCP_DOCKER": {
      "type": "local",
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run"
      ],
      "enabled": true
    }
  }
}
